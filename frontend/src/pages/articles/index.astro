---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getArticles } from '../../lib/api';

const PAGE_SIZE = 20;
const page = Number(Astro.url.searchParams.get('page') ?? '1');
const search = Astro.url.searchParams.get('search') ?? '';

const res = await getArticles({ page, page_size: PAGE_SIZE, search: search || undefined, ordering: '-published' });
---

<BaseLayout title="Articles" description="Browse all published articles">
	<div class="mb-6 flex items-center justify-between">
		<h1 class="text-2xl font-bold text-gray-900">Articles</h1>
		<span class="text-sm text-gray-400">{res.count} total</span>
	</div>

	<!-- Search -->
	<form method="get" class="mb-6">
		<div class="flex gap-2">
			<input
				type="search"
				name="search"
				value={search}
				placeholder="Search articles..."
				class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
			/>
			<button
				type="submit"
				class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors"
			>
				Search
			</button>
		</div>
	</form>

	{res.results.length > 0 ? (
		<div class="grid gap-4">
			{res.results.map((article) => (
				<ArticleCard article={article} />
			))}
		</div>
	) : (
		<div class="text-center py-16 text-gray-400">
			<p class="text-lg">No articles found{search ? ` for "${search}"` : ''}.</p>
		</div>
	)}

	<Pagination
		currentPage={page}
		totalCount={res.count}
		pageSize={PAGE_SIZE}
		baseUrl="/articles"
	/>
</BaseLayout>
