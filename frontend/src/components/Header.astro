---
const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/articles', label: 'Articles' },
	{ href: '/bulletins', label: 'Bulletins' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-gray-200 bg-white sticky top-0 z-10">
	<div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
		<a href="/" class="font-bold text-lg tracking-tight text-gray-900 hover:text-blue-600 transition-colors">
			Blog Platform
		</a>
		<nav class="flex items-center gap-6">
			{navLinks.map(({ href, label }) => (
				<a
					href={href}
					class={[
						'text-sm font-medium transition-colors hover:text-blue-600',
						currentPath === href ? 'text-blue-600' : 'text-gray-600',
					].join(' ')}
				>
					{label}
				</a>
			))}
			<a
				href="/login"
				class="text-sm font-medium bg-gray-900 text-white px-3 py-1.5 rounded-md hover:bg-gray-700 transition-colors"
			>
				Sign in
			</a>
		</nav>
	</div>
</header>
