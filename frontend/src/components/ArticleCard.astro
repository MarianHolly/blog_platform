---
import type { ArticleSummary } from '../lib/api';

interface Props {
	article: ArticleSummary;
}

const { article } = Astro.props;

const publishedDate = article.published
	? new Date(article.published).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
	: null;
---

<article class="border border-gray-200 rounded-xl p-5 hover:border-gray-300 hover:shadow-sm transition-all bg-white">
	<a href={`/articles/${article.slug}`} class="block group">
		<h2 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors leading-snug mb-1">
			{article.title}
		</h2>
		{article.subtitle && (
			<p class="text-gray-500 text-sm mb-3 leading-snug">{article.subtitle}</p>
		)}
	</a>

	<div class="flex items-center justify-between text-xs text-gray-400 mt-3">
		<div class="flex items-center gap-3">
			<a href={`/bulletins/${article.slug}`} class="hover:text-gray-600 transition-colors">
				{article.bulletin_title}
			</a>
			<span>by {article.author.full_name || article.author.username}</span>
		</div>
		<div class="flex items-center gap-3">
			{publishedDate && <time datetime={article.published ?? ''}>{publishedDate}</time>}
			<span>{article.likes_count} likes</span>
			<span>{article.comments_count} comments</span>
		</div>
	</div>
</article>
