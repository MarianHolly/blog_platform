# Production Environment Configuration for Coolify Deployment
# Copy these to Coolify's environment variables section
# NEVER commit actual secrets - this is just a template

# ============================================================================
# Django Settings
# ============================================================================

# Generate a NEW secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY

# CRITICAL: Set to False in production
DEBUG=False

# Add your domain and server IP (comma-separated)
# Example: yourdomain.com,www.yourdomain.com,123.456.789.012
ALLOWED_HOSTS=YOUR_DOMAIN.com,YOUR_SERVER_IP

# ============================================================================
# Database Configuration (Coolify PostgreSQL)
# ============================================================================

# Coolify will provide this - copy from Coolify database settings
# Format: postgresql://username:password@postgres:5432/database_name
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/blog_platform

# ============================================================================
# Redis Cache (Coolify Redis)
# ============================================================================

# Coolify will provide this - copy from Coolify Redis settings
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Cloudinary (Media Storage) - REQUIRED
# ============================================================================

# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================================================
# Superuser Auto-Creation
# ============================================================================

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@yourdomain.com
SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================================
# Security Settings (Recommended for Production)
# ============================================================================

# Enable HTTPS enforcement (only if SSL is configured)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================================================
# Email Configuration (Optional)
# ============================================================================

# Uncomment and configure if you need email functionality
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password

# ============================================================================
# Celery (Optional, already configured in settings)
# ============================================================================

# Uses same Redis as cache - no additional config needed
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================================================
# Notes
# ============================================================================

# 1. Generate NEW SECRET_KEY for production (don't reuse dev key)
# 2. Set strong SUPERUSER_PASSWORD
# 3. Get Cloudinary credentials from cloudinary.com (free tier available)
# 4. Copy DATABASE_URL from Coolify after creating PostgreSQL database
# 5. Copy REDIS_URL from Coolify after creating Redis instance
# 6. Update ALLOWED_HOSTS with your actual domain/IP
# 7. Keep this file secure - NEVER commit to version control
