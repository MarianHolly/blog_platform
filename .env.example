# Blog Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control (it contains secrets)

# ============================================================================
# Django Settings
# ============================================================================

# Generate a secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.local

# ============================================================================
# Database Configuration
# ============================================================================

# Option 1: PostgreSQL (Recommended for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_platform

# Option 2: Individual database settings (if DATABASE_URL not used)
# DB_NAME=blog_platform
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ============================================================================
# Redis Cache (Optional, falls back to database cache)
# ============================================================================

# Local Redis
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Cloudinary (Media Storage)
# ============================================================================

# Get these from https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# Superuser Creation (Auto-created during deployment)
# ============================================================================

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@blogplatform.com
SUPERUSER_PASSWORD=change-me-in-production

# ============================================================================
# Security Settings (for production)
# ============================================================================

# Enable HTTPS enforcement
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# ============================================================================
# Email Configuration (Optional, for notifications)
# ============================================================================

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# Celery Task Queue (Optional, configured but minimal usage currently)
# ============================================================================

# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================================
# Logging (Optional)
# ============================================================================

# LOG_LEVEL=INFO
# LOG_FILE=logs/blog_platform.log
