# Django Configuration
SECRET_KEY=your-secret-key-change-this-in-production-12345abcde
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (for Docker Compose, use 'postgres' as host)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration (for Docker Compose, use 'redis' as host)
REDIS_URL=redis://redis:6379/0

# Cloudinary Configuration (optional - for image uploads)
# Sign up at https://cloudinary.com to get these
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Superuser Account (created automatically by build.sh)
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@blogplatform.com
SUPERUSER_PASSWORD=admin123
