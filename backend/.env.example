# Copy to .env and fill in your values
# Generate SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=blog_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Or use a single DATABASE_URL instead of the above
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_platform

# Redis (optional — falls back to database cache if not set)
REDIS_URL=redis://localhost:6379/0

# Cloudinary — get from cloudinary.com/console (free tier available)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Superuser auto-creation
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@localhost
SUPERUSER_PASSWORD=changeme

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4321

# Production only
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SECURE_SSL_REDIRECT=True
